# ==========================================
# RENDER BACKEND ENVIRONMENT VARIABLES
# Copy and paste these in Render Dashboard -> Environment
# ==========================================

# 1. Server Port & Environment
PORT=5001
NODE_ENV=production

# 2. MongoDB Atlas Connection String
# (Replace with your actual MongoDB Atlas cluster connection string)
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/ats_resume?retryWrites=true&w=majority

# 3. JWT Authentication Key & Expiry
JWT_SECRET=ats_resume_super_secure_production_jwt_secret_2026_key
JWT_EXPIRES=7d

# 4. Frontend Client URL (Allow CORS from your Vercel URL)
# (Replace with your actual Vercel deployment URL)
CLIENT_URL=https://ats-resume-builder.vercel.app,http://localhost:3000

# 5. Email (SMTP) Configuration (For Forgot / Reset Password)
# If using Gmail, generate an "App Password" from your Google Account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=trendykart.app@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="ATS Resume <trendykart.app@gmail.com>"
